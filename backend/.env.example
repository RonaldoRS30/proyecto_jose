PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=consumo_electrico
DB_USER=root
DB_PASSWORD=

JWT_SECRET=tu_clave_secreta_jwt_cambiar_en_produccion
JWT_EXPIRES_IN=24h

CORS_ORIGIN=http://localhost:5173

# Demo remota desde PC (cloudflared/ngrok). En development ya se permiten dominios de tunel.
# DEMO_TUNNEL=true

# Admin por defecto (se crea al iniciar si no existe)
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=Admin123!

# Reset a producción (npm run db:reset-prod)
# PowerShell: $env:RESET_PROD_CONFIRM="YES"; npm run db:reset-prod
# bash:       RESET_PROD_CONFIRM=YES npm run db:reset-prod
